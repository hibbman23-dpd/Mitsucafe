# Claude session memory — ignore by default
.claude/*
# But commit the cafe-manager skill + agent + commands (cross-machine portable)
!.claude/skills/
!.claude/agents/
!.claude/commands/
# Still ignore local-only state
.claude/settings.local.json
.claude/state/
.claude/cache/

# Glide (replaced by web PWA)
glide/

# Secrets — không bao giờ commit
.env
.env.*
*.local
secrets.json
config.local.json
print-server/config.local.py

# clasp local credentials
.clasprc.json
.clasp.json.local

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
.python-version

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
node_modules/
dist/
build/

# QR generated labels (regenerate from script)
qr/labels/*.pdf
qr/labels/*.png

# Logs
*.log
logs/

# Test data
seed/test_order_*.json.local

# Wrangler cache
.wrangler/

# Firecrawl scrape/search cache (regenerate on demand)
.firecrawl/

# Dispatcher credential (local only)
.claude/.dispatcher-auth.json
ops/.dispatcher.lock

# Attendance (chấm công): payroll DB + salted PIN cache — KHÔNG commit.
# staff_cache.json là SHA-256(salt+pin) trên không gian 4 chữ số (10,000 khả
# năng) — lộ file + salt là dò được PIN thật trong vài giây.
print-server/attendance.db*
print-server/staff_cache.json*
*.salt

# CSDL SỐNG của print server — KHÔNG BAO GIỜ commit.
# 09/08/2026: outbox.db bị theo dõi bởi git, nên `git stash -u` đã đưa nó về bản
# commit cũ NGAY TRONG LÚC server đang mở nó với WAL đang chạy. Khởi động lại là
# file main không khớp WAL -> index ux_outbox_key lệch, bảng outbox dính 3 dòng
# rác, syncer chết vòng lặp, không đơn nào lên Sheets. Mất lịch sử 1270 đơn local.
# Bất kỳ lệnh git nào đụng working tree (stash/checkout/reset/clean) đều có thể
# tráo file database dưới chân tiến trình đang chạy. Để git ra ngoài hoàn toàn.
print-server/*.db
print-server/*.db-wal
print-server/*.db-shm
print-server/backups/
# ops/customer_reid.db do ops/dual_camera_ai.py ghi lúc chạy — cùng loại rủi ro.
ops/*.db
ops/*.db-wal
ops/*.db-shm

# Visual brainstorm companion artifacts
.superpowers/

# Brand source masters + asset backups (hi-res ~74MB — kept out of deploy path & git)
brand-assets/
# Stray large image at repo root (personal, not project)
anh_cua_ban_hd.png
# Unused loose source images in web/img (only stamps/ + mitsu/ are referenced)
web/img/[0-9]*.jpg
web/img/[0-9]*.png
web/img/[0-9]*.webp
