<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd plist — auto-start Flask print server khi Mac Mini login.

  Cài đặt (1 lần):
    cp ~/Projects/lamha-kissaten/print-server/com.lamha.kissaten.printserver.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.lamha.kissaten.printserver.plist

  Reload sau khi sửa:
    launchctl unload ~/Library/LaunchAgents/com.lamha.kissaten.printserver.plist
    launchctl load   ~/Library/LaunchAgents/com.lamha.kissaten.printserver.plist

  SOP nếu USB lỗi (Access denied):
    launchctl unload ... → launchctl load ...
    (Nếu vẫn lỗi: rút USB printer → cắm lại → load lại)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lamha.kissaten.printserver</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>/Users/dpd/Projects/lamha-kissaten/print-server/print_server.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RECEIPT_MODE</key><string>usb</string>
        <key>RECEIPT_USB_VID</key><string>10473</string>
        <key>RECEIPT_USB_PID</key><string>649</string>
        <key>LABEL_MODE</key><string>usb</string>
        <key>LABEL_USB_VID</key><string>8137</string>
        <key>LABEL_USB_PID</key><string>8214</string>
        <key>SERVER_PORT</key><string>5001</string>
        <key>LOG_LEVEL</key><string>INFO</string>
        <key>DYLD_LIBRARY_PATH</key><string>/opt/homebrew/lib</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/dpd/Projects/lamha-kissaten/print-server</string>

    <key>StandardOutPath</key>
    <string>/tmp/print_server.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/print_server.log</string>

    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
</dict>
</plist>
