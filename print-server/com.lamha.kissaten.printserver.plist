<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd plist để auto-start Flask print server khi Mac Mini đăng nhập.

  Cài đặt:
    1. Sửa <PATH-TO-PROJECT> phía dưới thành đường dẫn thật (ví dụ /Users/dpd/Projects/lamha-kissaten)
    2. cp com.lamha.kissaten.printserver.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.lamha.kissaten.printserver.plist
    4. Test:  curl http://localhost:5000/health

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.lamha.kissaten.printserver.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lamha.kissaten.printserver</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string><PATH-TO-PROJECT>/print-server/print_server.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PRINTER_IP</key>
        <string>192.168.1.50</string>
        <key>PRINTER_PORT</key>
        <string>9100</string>
        <key>SERVER_PORT</key>
        <string>5000</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string><PATH-TO-PROJECT>/print-server/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string><PATH-TO-PROJECT>/print-server/logs/stderr.log</string>

    <key>WorkingDirectory</key>
    <string><PATH-TO-PROJECT>/print-server</string>
</dict>
</plist>
