<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd plist — auto-start KDS Gateway & Print Server khi Mac Mini login.

  Cài đặt (1 lần):
    cp ~/Projects/lamha-kissaten/print-server/com.lamha.kissaten.printserver.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.lamha.kissaten.printserver.plist

  Reload sau khi sửa:
    launchctl unload ~/Library/LaunchAgents/com.lamha.kissaten.printserver.plist
    launchctl load   ~/Library/LaunchAgents/com.lamha.kissaten.printserver.plist

  Log: tail -f /tmp/print_server.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lamha.kissaten.printserver</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>/Users/dpd/Projects/lamha-kissaten/print-server/print_server.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>GAS_WEBAPP_URL</key><string>https://script.google.com/macros/s/AKfycbynDqbg-Xn9hEbUyhsZl_MF0dGsCqLpfTgJ-Us3QHiGqkrKV3hwZD__-fKW2kFJZzC7/exec</string>
        <key>REPORT_API_TOKEN</key><string>REPLACE_WITH_REPORT_API_TOKEN</string>
        <key>GATEWAY_DB</key><string>/Users/dpd/Projects/lamha-kissaten/print-server/outbox.db</string>
        <key>SYNC_INTERVAL</key><string>3</string>
        <key>SERVER_PORT</key><string>5001</string>
        <key>LOG_LEVEL</key><string>INFO</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/dpd/Projects/lamha-kissaten/print-server</string>

    <key>StandardOutPath</key>
    <string>/tmp/print_server.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/print_server.log</string>

    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
</dict>
</plist>
